{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "guilherme-ferreira-two.vercel.app"
        }
      ],
      "destination": "https://eoguilhermeferreira.vercel.app/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "guilhermeferreira-vibecoder.vercel.app"
        }
      ],
      "destination": "https://eoguilhermeferreira.vercel.app/$1",
      "permanent": true
    }
  ]
}
